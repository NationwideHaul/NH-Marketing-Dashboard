# ===========================================
# NH Marketing Dashboard - Environment Variables
# ===========================================

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # Generate with: openssl rand -base64 32

# ---- Google OAuth (covers GA4, Ads, GMB, YouTube) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Project: nh-marketing-dashboard

# ---- Google Analytics 4 ----
GA4_PROPERTY_ID=  # e.g., 123456789

# ---- Google Ads ----
GOOGLE_ADS_CUSTOMER_ID=  # e.g., 123-456-7890 (no dashes)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_ID=  # Optional: MCC account ID

# ---- Google My Business ----
GMB_ACCOUNT_ID=
GMB_LOCATION_ID=

# ---- YouTube ----
YOUTUBE_CHANNEL_ID=

# ---- Meta (Facebook + Instagram) ----
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=  # System user long-lived token (60 day expiry)
META_AD_ACCOUNT_ID=  # e.g., act_123456789
META_PAGE_ID=  # Facebook Page ID
META_IG_USER_ID=  # Instagram Business Account ID (linked to FB Page)

# ---- RingCentral (Call Tracking) ----
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT_TOKEN=  # Service account JWT

# ---- Go High Level (Email Marketing) ----
GHL_API_KEY=
GHL_LOCATION_ID=

# ---- LinkedIn ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=  # OAuth 2.0 token
LINKEDIN_ORGANIZATION_ID=  # Company page ID
LINKEDIN_AD_ACCOUNT_ID=  # Sponsored content account
